---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AiWizardModal from '../components/AiWizardModal.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  canonical?: string;
  jsonLd?: object[];
  noindex?: boolean;
  /** 首页 Hero 覆盖模式（Header 透明悬浮） */
  overlayHeader?: boolean;
}

const { title, description, ogImage, ogType, canonical, jsonLd, noindex, overlayHeader = false } =
  Astro.props;
---

<html lang="zh-CN">
  <head>
    <BaseHead
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      canonical={canonical}
      jsonLd={jsonLd}
      noindex={noindex}
    />
    <!-- Commission Factory affiliate site ownership verification (unistay.cn) -->
    <meta
      name="commission-factory-verification"
      content="aac649e9033849b7b12c6e457eaf7520"
    />
  </head>
  <body>
    <Header overlay={overlayHeader} />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // scroll-reveal（respect prefers-reduced-motion；防双绑）
      (function () {
        function initReveal() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('.us-reveal').forEach(function (el) {
              el.classList.add('is-in');
            });
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) {
                  e.target.classList.add('is-in');
                  io.unobserve(e.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.05 }
          );
          document.querySelectorAll('.us-reveal:not([data-us-rv])').forEach(function (el) {
            el.setAttribute('data-us-rv', '1');
            io.observe(el);
          });
        }
        document.addEventListener('astro:page-load', initReveal);
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal);
        } else {
          initReveal();
        }
      })();
    </script>

    <!-- AI 找房向导 · 弹窗（全站 window.aiwOpen 入口） -->
    <AiWizardModal />

    <!-- UniStay 优住 · chatbot / 留资 / 归因 三件套 -->
    <script
      src="https://chat.unistay.cn/lead.js"
      data-site="unistay-cn"
      data-lang="zh-CN"
      data-apply-base="https://apply.unistay.cn"
      async
      data-color="#4B3FE4"
      data-accent="#CDEB5A"></script>
    <!--
      2026-08-15 · R195：本站是简体中文站（lang: zh-CN），简中页不得出现任何对话式界面，
      咨询入口一律指向本站企业微信客服。原来这里常驻加载 chat.unistay.cn/assistant.js
      （「住宿小助手」对话框），已移除。

      移除后仍然齐全，不留空窗：
        · 咨询 —— 上面的 lead.js 在简中分支渲染「微信咨询」按钮，指向本站专属客服号
          （岛主主体，准源 credentials.wecom_arrivau.kf_accounts；小程序主体例外见
          wechat-kf-dual-subject-ref.md §1）。
        · 主功能 —— <AiWizardModal /> 的 AI 找房向导照旧，它是分步**表单**不是对话框，
          R195 明确「非对话式的工具（表单、测算、比价、筛选、下载）不受本条影响」。
    -->

  </body>
</html>
